    "test": "playwright test smoke.spec.js --reporter=line --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "dependencies": {
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/theme-one-dark": "6.1.3",
    "codemirror": "6.0.2",
    "cytoscape": "3.34.1"
  }
}
